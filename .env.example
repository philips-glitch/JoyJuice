# Postgres connection string. Locally you'll normally get this by running
# `vercel link` then `vercel env pull .env` once the Prisma Postgres
# Marketplace integration is added to your Vercel project (see README).
DATABASE_URL="postgres://user:password@host:5432/dbname"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="replace-with-a-random-32-byte-base64-string"
