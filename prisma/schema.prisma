generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  BRONZE
  SILVER
  GOLD
  PLATINUM
}

enum PointsTxType {
  EARN
  REDEEM
  BONUS
  ADJUST
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  PREPARING
  ON_DELIVERY
  COMPLETED
  CANCELLED
}

enum DeliveryMethod {
  INSTANT_COURIER
  PICKUP
}

enum PaymentMethod {
  QRIS
  VIRTUAL_ACCOUNT
  MANUAL_TRANSFER
}

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id             String    @id @default(cuid())
  name           String
  username       String    @unique
  email          String?   @unique
  passwordHash   String
  phone          String?
  role           Role      @default(CUSTOMER)
  points         Int       @default(0)
  lifetimePoints Int       @default(0)
  tier           Tier      @default(BRONZE)
  bonusClaimed   Boolean   @default(false)
  suspended      Boolean   @default(false)
  verified       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  cartItems         CartItem[]
  orders            Order[]
  pointsTransactions PointsTransaction[]
  rewardRedemptions RewardRedemption[]
  voucherRedemptions VoucherRedemption[]
}

model Product {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  category    String
  description String
  ingredients String
  image       String
  basePrice   Int
  calories    Int
  volumeMl    Int
  rating      Float    @default(4.8)
  tag         String?
  pointsBadge Int
  sizes       String
  toppings    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  cartItems  CartItem[]
  orderItems OrderItem[]
}

model CartItem {
  id            String   @id @default(cuid())
  userId        String
  productId     String
  quantity      Int      @default(1)
  size          String
  iceLevel      String
  sweetness     String
  toppings      String
  note          String?
  unitPrice     Int
  createdAt     DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model Order {
  id               String         @id @default(cuid())
  userId           String
  status           OrderStatus    @default(PENDING_PAYMENT)
  deliveryMethod   DeliveryMethod
  deliveryOption   String
  shippingFee      Int
  address          String?
  whatsapp         String
  driverNote       String?
  paymentMethod    PaymentMethod
  subtotal         Int
  memberDiscount   Int
  pointsRedeemed   Int            @default(0)
  pointsDiscount   Int            @default(0)
  voucherCode      String?
  voucherDiscount  Int            @default(0)
  total            Int
  pointsEarned     Int
  createdAt        DateTime       @default(now())

  user  User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items OrderItem[]
  pointsTransactions PointsTransaction[]
  voucherRedemptions VoucherRedemption[]
}

model OrderItem {
  id         String @id @default(cuid())
  orderId    String
  productId  String
  name       String
  image      String
  quantity   Int
  unitPrice  Int
  size       String
  iceLevel   String
  sweetness  String
  toppings   String

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model PointsTransaction {
  id            String       @id @default(cuid())
  userId        String
  orderId       String?
  type          PointsTxType
  amount        Int
  balanceAfter  Int
  description   String
  createdAt     DateTime     @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  order Order? @relation(fields: [orderId], references: [id], onDelete: SetNull)
}

model RewardItem {
  id          String   @id @default(cuid())
  name        String
  description String
  image       String
  pointsCost  Int
  category    String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  redemptions RewardRedemption[]
}

model RewardRedemption {
  id           String   @id @default(cuid())
  userId       String
  rewardItemId String
  pointsSpent  Int
  createdAt    DateTime @default(now())

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  rewardItem RewardItem @relation(fields: [rewardItemId], references: [id], onDelete: Cascade)
}

model TierConfig {
  tier              Tier     @id
  label             String
  minLifetimePoints Int
  multiplier        Float
  flatDiscount      Int
  color             String
  updatedAt         DateTime @updatedAt
}

model Voucher {
  id             String    @id @default(cuid())
  code           String    @unique
  discountAmount Int
  active         Boolean   @default(true)
  maxRedemptions Int?
  perUserLimit   Int?
  expiresAt      DateTime?
  createdAt      DateTime  @default(now())

  redemptions VoucherRedemption[]
}

model VoucherRedemption {
  id        String   @id @default(cuid())
  voucherId String
  userId    String
  orderId   String?
  createdAt DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)
}
